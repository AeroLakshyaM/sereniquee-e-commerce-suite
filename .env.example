# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Instagram API Configuration (Optional)
# Get these from: https://developers.facebook.com/apps/
# Follow INSTAGRAM_SETUP.md guide for setup instructions
VITE_INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
VITE_INSTAGRAM_USER_ID=your_instagram_user_id

# Server-side Resend configuration (set these in Vercel, not as VITE_ variables)
RESEND_API_KEY=your_resend_api_key
# Supabase service-role key used only by protected Vercel API functions.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Comma-separated addresses that should receive every new-order notification.
# Add at least two addresses, for example: owner@example.com,production@example.com
ORDER_NOTIFICATION_EMAILS=first@example.com,second@example.com
